{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nook/roomplan.schema.json",
  "title": "nook capture v1.3 roomplan.json (contract \u00a74.12)",
  "type": "object",
  "required": [
    "version",
    "walls",
    "floors"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "walls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "floors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "doors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "world_from_roomplan": {
      "$ref": "#/$defs/mat4"
    }
  },
  "$defs": {
    "mat4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "number"
        }
      }
    },
    "surface": {
      "type": "object",
      "required": [
        "id",
        "dimensions",
        "transform"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "transform": {
          "$ref": "#/$defs/mat4"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string"
        }
      }
    }
  }
}
